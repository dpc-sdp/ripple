{#
/**
 * Ripple Alert Component - Twig Template
 *
 * Available variables:
 * - variant: Alert variant ('information', 'warning', 'error')
 * - icon_name: Icon identifier (default based on variant)
 * - message: Alert message text (required)
 * - link_text: Optional link text
 * - link_url: Optional link URL
 * - alert_id: Unique identifier for the alert (required)
 * - is_dismissible: Whether alert can be dismissed (default: true)
 * - dismissed: Initial dismissed state (default: false)
 */
#}
{% set variant = variant|default('information') %}
{% set is_dismissible = is_dismissible is defined ? is_dismissible : true %}
{% set dismissed = dismissed|default(false) %}

{# Set default icon based on variant if not provided #}
{% if icon_name is not defined %}
  {% if variant == 'warning' %}
    {% set icon_name = 'icon-alert-information' %}
  {% elseif variant == 'error' %}
    {% set icon_name = 'icon-cancel-circle' %}
  {% else %}
    {% set icon_name = 'icon-information-circle-filled' %}
  {% endif %}
{% endif %}

{% set classes = [
  'rpl-alert',
  'rpl-alert--' ~ variant,
  dismissed ? 'rpl-alert--closed' : null,
  'rpl-u-screen-only'
] %}

<rpl-alert
  class="{{ classes|join(' ')|trim }}"
  data-alert-id="{{ alert_id }}"
  data-message="{{ message }}"
  {% if dismissed %}data-dismissed="true"{% endif %}
>
  {% if not dismissed %}
  <div
    class="rpl-alert__inner"
    role="region"
    aria-labelledby="alert-message-{{ alert_id }}"
  >
    <span class="rpl-alert__icon-info rpl-icon rpl-icon--size-m">
      <svg role="presentation">
        <use xlink:href="#{{ icon_name }}"></use>
      </svg>
    </span>

    <div class="rpl-alert__message-wrap">
      <div
        id="alert-message-{{ alert_id }}"
        class="rpl-alert__message rpl-type-label rpl-type-weight-bold"
      >
        {{ message }}
      </div>

      {% if link_text and link_url %}
      <a
        href="{{ link_url }}"
        class="rpl-alert__link rpl-text-link rpl-type-p rpl-u-focusable-inline rpl-u-focusable--alt-colour"
      >
        {{ link_text }}
        <span class="rpl-icon rpl-icon--size-s">
          <svg role="presentation">
            <use xlink:href="#icon-arrow-right"></use>
          </svg>
        </span>
      </a>
      {% endif %}
    </div>

    {% if is_dismissible %}
    <button
      class="rpl-alert__btn-close rpl-u-focusable-inline rpl-u-focusable--alt-colour"
      data-dismiss="true"
      aria-label="Dismiss alert"
    >
      <span class="rpl-icon rpl-icon--size-s">
        <svg role="presentation" aria-label="Dismiss alert">
          <use xlink:href="#icon-cancel"></use>
        </svg>
      </span>
    </button>
    {% endif %}
  </div>
  {% endif %}
</rpl-alert>
