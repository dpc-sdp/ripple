{#
/**
 * Ripple Accordion Component - Twig Template
 *
 * Available variables:
 * - id: Unique accordion identifier
 * - items: Array of accordion items with id, title, content and optional active
 * - numbered: Whether to display item numbers
 * - displayToggleAll: Whether to display the open/close all control
 */
#}
{% set id = id|default('accordion') %}
{% set items = items|default([]) %}
{% set numbered = numbered|default(false) %}
{% set displayToggleAll = displayToggleAll is defined ? displayToggleAll : true %}
{% set all_active = items|length > 0 %}

{% for item in items %}
  {% if not item.active %}
    {% set all_active = false %}
  {% endif %}
{% endfor %}

<rpl-accordion class="rpl-accordion" data-accordion-id="{{ id }}">
  {% if displayToggleAll and items|length > 1 %}
  <div class="rpl-accordion__toggle-all-wrapper rpl-u-screen-only">
    <button
      class="rpl-accordion__toggle-all rpl-u-focusable-inline"
      type="button"
      data-accordion-toggle-all
    >
      {{ all_active ? 'Close all' : 'Open all' }}
    </button>
  </div>
  {% endif %}

  <{{ numbered ? 'ol' : 'ul' }} class="rpl-accordion__items">
    {% for item in items %}
    {% set item_id = 'accordion-' ~ id ~ '-' ~ item.id %}
    <li class="rpl-accordion__item{{ item.active ? ' rpl-accordion__item--active' : '' }}" id="{{ item_id }}">
      <button
        id="{{ item_id }}-toggle"
        class="rpl-accordion__item-toggle rpl-u-focusable-block"
        type="button"
        aria-controls="{{ item_id }}-content"
        aria-expanded="{{ item.active ? 'true' : 'false' }}"
        data-accordion-toggle
      >
        <span class="rpl-accordion__item-heading-wrapper">
          {% if numbered %}
          <span class="rpl-accordion__item-number rpl-type-h4">
            {{ loop.index }}
          </span>
          {% endif %}

          <span class="rpl-accordion__item-heading rpl-type-h4">
            {{ item.title }}
          </span>
        </span>

        <span
          class="rpl-accordion__item-icon rpl-u-screen-only"
          aria-hidden="true"
        >
          <span class="rpl-icon rpl-icon--size-s">
            <svg role="presentation">
              <use xlink:href="#icon-chevron-down"></use>
            </svg>
          </span>
        </span>
      </button>

      <div
        id="{{ item_id }}-content"
        class="rpl-accordion__item-content rpl-expandable{{ item.active ? ' rpl-expandable--open rpl-expandable--start-expanded' : '' }}"
        role="region"
        aria-labelledby="{{ item_id }}-toggle"
        {% if not item.active %}aria-hidden="true" hidden{% endif %}
      >
        <div class="rpl-accordion__item-content-inner">
          {{ item.content|raw }}
        </div>
      </div>
    </li>
    {% endfor %}
  </{{ numbered ? 'ol' : 'ul' }}>
</rpl-accordion>
