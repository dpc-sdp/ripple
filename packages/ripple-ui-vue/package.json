{
  "name": "@dpc-sdp/ripple-ui-vue",
  "version": "0.0.0",
  "type": "module",
  "files": [
    "dist",
    "src"
  ],
  "types": "./dist/index.d.ts",
  "peerDependencies": {
    "vue": "^3.4.0"
  },
  "dependencies": {
    "@dpc-sdp/ripple-ui-shared": "workspace:*",
    "@dpc-sdp/ripple-ui-styles": "workspace:*"
  },
  "exports": {
    ".": "./dist/index.js",
    "./components/*": "./dist/components/*"
  },
  "devDependencies": {
    "@storybook/vue3-vite": "^10.4.2",
    "@vitejs/plugin-vue": "^6.0.4",
    "@vue/compiler-sfc": "^3.5.26",
    "eslint-plugin-storybook": "^10.4.2",
    "rimraf": "catalog:",
    "storybook": "^10.4.2",
    "typescript": "^5.9.3",
    "vite": "catalog:",
    "vite-svg-loader": "catalog:",
    "vue": "^3.5.26",
    "vue-tsc": "catalog:"
  },
  "scripts": {
    "build": "pnpm clean && pnpm build:lib && pnpm build:types",
    "build:lib": "vite build",
    "build:types": "vue-tsc -p tsconfig.typecheck.json --declaration --emitDeclarationOnly --outDir dist",
    "clean": "(rimraf dist* && rimraf tsconfig.tsbuildinfo) | true",
    "typecheck": "vue-tsc -p tsconfig.typecheck.json --noEmit",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build"
  },
  "eslintConfig": {
    "extends": [
      "plugin:storybook/recommended"
    ]
  }
}
