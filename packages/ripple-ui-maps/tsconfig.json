{
  "compilerOptions": {
    "noImplicitAny": false,
    "outDir": "dist",
    "baseUrl": "./src",
    "target": "esnext",
    "useDefineForClassFields": true,
    "module": "esnext",
    "moduleResolution": "node",
    "isolatedModules": true,
    "strict": false,
    "jsx": "preserve",
    "sourceMap": true,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "types": ["vite/client"],
    "paths": {
      "@/*": ["src/*"]
    },
    "lib": ["esnext", "dom", "dom.iterable", "scripthost"],
    "skipLibCheck": true,
    "declaration": true
  },
  "exclude": ["**/*.stories.ts", "**/*.stories.mdx", "dist", "stories", "**/*.cy.ts"]
}
