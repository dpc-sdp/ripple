{#
/**
 * Ripple Text Link Component - Twig Template
 *
 * Available variables:
 * - url: The URL for the link (required)
 * - text: The link text content
 * - target: Link target attribute (e.g., '_blank' for new window)
 * - rel: Link rel attribute (e.g., 'noopener noreferrer')
 * - title: Link title attribute
 * - class: Additional CSS classes
 */
#}
{% set url = url|default('#') %}
{% set target = target|default(null) %}
{% set rel = rel|default(null) %}
{% set title = title|default(null) %}
{% set open_in_new_window = target == '_blank' %}

{% set classes = [
  'rpl-text-link',
  'rpl-u-focusable-inline',
  class ? class : null
] %}

<a
  href="{{ url }}"
  class="{{ classes|join(' ')|trim }}"
  {% if target %}target="{{ target }}"{% endif %}
  {% if rel %}rel="{{ rel }}"{% endif %}
  {% if title %}title="{{ title }}"{% endif %}
>
  {{ text }}
  {% if open_in_new_window %}
  <span class="rpl-u-visually-hidden"> (opens in a new window)</span>
  {% endif %}
</a>
