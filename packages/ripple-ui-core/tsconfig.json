{
  "compilerOptions": {
    "noImplicitAny": false,
    "outDir": "dist",
    "rootDir": "src/",
    "target": "esnext",
    "useDefineForClassFields": true,
    "module": "esnext",
    "moduleResolution": "node",
    "isolatedModules": true,
    "strict": false,
    "jsx": "preserve",
    "sourceMap": true,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "types": ["vite/client", "cypress"],
    "paths": {
      "*": ["./src/*"],
      "@/*": ["./src/*"]
    },
    "lib": ["esnext", "dom", "dom.iterable", "scripthost"],
    "skipLibCheck": true,
    "declaration": true
  },
  "include": [
    "env.d.ts",
    "src/index.ts",
    "src/nuxt/**/*.ts",
    "src/tokens/**/*.ts",
    "src/tokens/**/*.json",
    "src/scripts/**/*.ts"
  ],
  "exclude": ["src/components/global/stories/*"]
}
